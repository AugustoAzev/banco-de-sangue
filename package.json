{
  "name": "banco-de-sangue",
  "private": true,
  "version": "1.3.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test",
    "build": "next build",
    "postbuild": "node scripts/preparar-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "package": "node scripts/empacotar-build.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.555.0",
    "next": "^15.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
