            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/cep/123",
              "host": ["{{base_url}}"],
              "path": ["api", "cep", "123"]
            },
            "description": "Validado ANTES de chamar o ViaCEP - evita repassar o erro HTML 400 do provedor externo pro cliente."
          },
          "response": [
